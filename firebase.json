{
  "hosting": {
    "site": "sekai-story-indexer",
    "public": "frontend/dist/client",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "sekai-story-indexer",
          "region": "us-central1"
        }
      }
    ]
  }
}
